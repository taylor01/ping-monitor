{
  "title": "Network Ping Monitor",
  "description": "Distributed ping monitoring across all sites",
  "widgets": [
    {
      "id": 1,
      "definition": {
        "title": "Hosts Up vs Down",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:custom.ping.reachable{*}",
            "aggregator": "last"
          }
        ],
        "precision": 0,
        "custom_unit": "up"
      },
      "layout": {"x": 0, "y": 0, "width": 2, "height": 2}
    },
    {
      "id": 2,
      "definition": {
        "title": "Hosts Down",
        "type": "query_value",
        "requests": [
          {
            "q": "count_nonzero(sum:custom.ping.reachable{*} by {host}) - sum:custom.ping.reachable{*}",
            "aggregator": "last",
            "conditional_formats": [
              {"comparator": ">", "value": 0, "palette": "white_on_red"},
              {"comparator": "<=", "value": 0, "palette": "white_on_green"}
            ]
          }
        ],
        "precision": 0,
        "custom_unit": "down"
      },
      "layout": {"x": 2, "y": 0, "width": 2, "height": 2}
    },
    {
      "id": 3,
      "definition": {
        "title": "Host Status Map",
        "type": "hostmap",
        "requests": {
          "fill": {
            "q": "avg:custom.ping.reachable{*} by {host}"
          }
        },
        "style": {
          "palette": "green_to_orange",
          "palette_flip": false
        },
        "group": ["site"],
        "no_group_hosts": false,
        "no_metric_hosts": true
      },
      "layout": {"x": 4, "y": 0, "width": 8, "height": 4}
    },
    {
      "id": 4,
      "definition": {
        "title": "All Hosts Status",
        "type": "query_table",
        "requests": [
          {
            "q": "avg:custom.ping.reachable{*} by {host,ip,site,device_type}",
            "alias": "Status",
            "conditional_formats": [
              {"comparator": "<", "value": 1, "palette": "white_on_red"},
              {"comparator": ">=", "value": 1, "palette": "white_on_green"}
            ]
          },
          {
            "q": "avg:custom.ping.latency_ms{*} by {host,ip,site,device_type}",
            "alias": "Latency (ms)"
          },
          {
            "q": "avg:custom.ping.packet_loss{*} by {host,ip,site,device_type}",
            "alias": "Packet Loss %"
          }
        ]
      },
      "layout": {"x": 0, "y": 2, "width": 12, "height": 4}
    },
    {
      "id": 5,
      "definition": {
        "title": "Latency Over Time",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:custom.ping.latency_ms{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {"x": 0, "y": 6, "width": 6, "height": 3}
    },
    {
      "id": 6,
      "definition": {
        "title": "Packet Loss Over Time",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:custom.ping.packet_loss{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {"x": 6, "y": 6, "width": 6, "height": 3}
    },
    {
      "id": 7,
      "definition": {
        "title": "Status by Site",
        "type": "toplist",
        "requests": [
          {
            "q": "sum:custom.ping.reachable{*} by {site}"
          }
        ]
      },
      "layout": {"x": 0, "y": 9, "width": 4, "height": 3}
    },
    {
      "id": 8,
      "definition": {
        "title": "Highest Latency Hosts",
        "type": "toplist",
        "requests": [
          {
            "q": "top(avg:custom.ping.latency_ms{*} by {host}, 10, 'mean', 'desc')"
          }
        ]
      },
      "layout": {"x": 4, "y": 9, "width": 4, "height": 3}
    },
    {
      "id": 9,
      "definition": {
        "title": "Down Hosts (Last 24h)",
        "type": "event_timeline",
        "query": "custom.ping.reachable:0"
      },
      "layout": {"x": 8, "y": 9, "width": 4, "height": 3}
    }
  ],
  "template_variables": [
    {
      "name": "site",
      "default": "*",
      "prefix": "site"
    },
    {
      "name": "device_type",
      "default": "*",
      "prefix": "device_type"
    }
  ],
  "layout_type": "ordered",
  "is_read_only": false,
  "notify_list": []
}
